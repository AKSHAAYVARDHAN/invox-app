rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function currentUser() {
      return get(userPath(uid())).data;
    }

    function hasRole(role) {
      return signedIn()
        && exists(userPath(uid()))
        && currentUser().role == role;
    }

    function isModerator() {
      return hasRole('moderator') || hasRole('admin');
    }

    function isAdmin() {
      return (signedIn() && exists(userPath(uid())) && currentUser().role == 'admin')
        || (signedIn() && request.auth.token.email in ['akshaayvardhans@gmail.com']);
    }

    function owns(field) {
      return signedIn() && request.resource.data[field] == uid();
    }

    function existingOwner(field) {
      return signedIn() && resource.data[field] == uid();
    }

    // Canonical accepted (mutual) connection check between current user and target user
    function isAcceptedConnection(targetUserId) {
      return signedIn() && (
        targetUserId == uid() ||
        (exists(/databases/$(database)/documents/follows/$(uid())_$(targetUserId))
         && exists(/databases/$(database)/documents/follows/$(targetUserId)_$(uid())))
      );
    }

    // Identifies whether post document is Hub content (Moments or Loops)
    function isHubPostData(data) {
      return ('isHub' in data && data.isHub == true)
        || ('type' in data && (data.type == 'Moment' || data.type == 'Loop' || data.type == 'still' || data.type == 'tape' || data.type == 'knack'))
        || ('postType' in data && (data.postType == 'Moment' || data.postType == 'Loop'))
        || ('momentType' in data && data.momentType != null)
        || ('isLoop' in data && data.isLoop == true);
    }

    function protectedUserFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'uid',
        'role',
        'followerCount',
        'followingCount',
        'savedPostCount',
        'savedProjectCount',
        'savedOpportunityCount',
        'reputation',
        'createdAt'
      ]);
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && userId == uid()
        && request.resource.data.uid == uid()
        && request.resource.data.role == 'user';
      allow update: if isAdmin() || (signedIn() && userId == uid() && !protectedUserFieldsChanged());
      allow delete: if isAdmin();

      match /sparkConversations/{conversationId} {
        allow read, write: if signedIn() && userId == uid();
      }
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == uid();
      allow update: if signedIn() && resource.data.uid == uid() && request.resource.data.uid == uid();
      allow delete: if signedIn() && resource.data.uid == uid();
    }

    match /channels/{channelId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == uid();
      allow update, delete: if signedIn() && (resource.data.ownerId == uid() || isModerator());
    }

    match /posts/{postId} {
      // Hub content (Moments & Loops) is strictly private to author and accepted connections
      allow get: if !isHubPostData(resource.data)
        || (signedIn() && (resource.data.authorId == uid() || isAcceptedConnection(resource.data.authorId) || isModerator()));

      allow list: if signedIn() && (
        (!isHubPostData(resource.data))
        || (resource.data.authorId == uid())
        || (isAcceptedConnection(resource.data.authorId))
        || isModerator()
      );

      allow create: if signedIn()
        && request.resource.data.authorId == uid()
        && (
          (request.resource.data.type == 'Feed' || request.resource.data.postType == 'Feed' || request.resource.data.channelId != null)
            ? (request.resource.data.channelId is string
               && exists(/databases/$(database)/documents/channels/$(request.resource.data.channelId))
               && get(/databases/$(database)/documents/channels/$(request.resource.data.channelId)).data.ownerId == uid())
            : true
        );

      allow update: if signedIn() && (
        (('authorId' in resource.data) && resource.data.authorId == uid())
        || isModerator()
        || (
          // Stat/reaction updates on Hub posts require accepted connection
          (!isHubPostData(resource.data) || isAcceptedConnection(resource.data.authorId))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stats', 'likeCount', 'viewCount', 'commentCount', 'saveCount', 'strikeCount', 'strikes', 'updatedAt'])
        )
      );
      allow delete: if signedIn() && ((('authorId' in resource.data) && resource.data.authorId == uid()) || isModerator());
    }

    match /polls/{pollId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == uid();
      allow update: if signedIn() && (
        ('authorId' in resource.data && resource.data.authorId == uid())
        || isModerator()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalVotes', 'options', 'stats', 'likeCount', 'viewCount', 'commentCount', 'updatedAt'])
      );
      allow delete: if signedIn() && (('authorId' in resource.data && resource.data.authorId == uid()) || isModerator());

      match /votes/{userId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && userId == uid() && request.resource.data.userId == uid();
        allow delete: if signedIn() && userId == uid();
      }
    }

    match /projects/{projectId} {
      allow read: if signedIn() && (resource.data.status == 'published' || resource.data.authorId == uid() || isModerator());
      allow create: if owns('authorId');
      allow update, delete: if existingOwner('authorId') || isModerator();
    }

    match /trendz/{trendId} {
      allow read: if signedIn();
      allow write: if isModerator();
    }

    match /communities/{communityId} {
      allow read: if signedIn();
      allow create: if owns('ownerId');
      allow update, delete: if existingOwner('ownerId') || isModerator();
    }

    match /communityMemberships/{membershipId} {
      allow read: if signedIn();
      allow create: if owns('userId');
      allow update, delete: if existingOwner('userId') || isModerator();
    }

    match /comments/{commentId} {
      function canAccessCommentTarget(postId) {
        return !exists(/databases/$(database)/documents/posts/$(postId))
          || !isHubPostData(get(/databases/$(database)/documents/posts/$(postId)).data)
          || isAcceptedConnection(get(/databases/$(database)/documents/posts/$(postId)).data.authorId)
          || isModerator();
      }

      allow get: if signedIn() && (!('postId' in resource.data) || canAccessCommentTarget(resource.data.postId));
      allow list: if signedIn();
      allow create: if owns('authorId') && (!('postId' in request.resource.data) || canAccessCommentTarget(request.resource.data.postId));
      allow update, delete: if existingOwner('authorId') || isModerator();
    }

    match /likes/{likeId} {
      allow read: if signedIn();
      allow create: if owns('userId');
      allow delete: if existingOwner('userId') || isModerator();
      allow update: if false;
    }

    match /bookmarks/{bookmarkId} {
      allow read: if signedIn() && resource.data.userId == uid();
      allow create: if owns('userId');
      allow delete: if existingOwner('userId') || isModerator();
      allow update: if false;
    }

    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && (
                      (('followerId' in request.resource.data) && request.resource.data.followerId == uid()) ||
                      (('followerUid' in request.resource.data) && request.resource.data.followerUid == uid())
                    )
                    && (
                      (!('followerId' in request.resource.data) || !('followingId' in request.resource.data) || request.resource.data.followerId != request.resource.data.followingId) &&
                      (!('followerUid' in request.resource.data) || !('followingUid' in request.resource.data) || request.resource.data.followerUid != request.resource.data.followingUid)
                    );
      allow delete: if signedIn() && (
                      (('followerId' in resource.data) && resource.data.followerId == uid()) ||
                      (('followerUid' in resource.data) && resource.data.followerUid == uid()) ||
                      isModerator()
                    );
      allow update: if false;
    }

    match /applications/{applicationId} {
      allow read: if signedIn() && (resource.data.applicantId == uid() || resource.data.ownerId == uid() || (('creatorId' in resource.data) && resource.data.creatorId == uid()) || isModerator());
      allow create: if owns('applicantId');
      allow update: if signedIn() && (resource.data.applicantId == uid() || resource.data.ownerId == uid() || (('creatorId' in resource.data) && resource.data.creatorId == uid()) || isModerator());
      allow delete: if isModerator();
    }

    match /savedOpportunities/{savedId} {
      allow read: if signedIn() && resource.data.userId == uid();
      allow create: if owns('userId');
      allow delete: if existingOwner('userId') || isModerator();
      allow update: if false;
    }

    match /notifications/{notificationId} {
      allow read, delete: if signedIn() && resource.data.recipientId == uid();
      allow update: if signedIn() && resource.data.recipientId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt', 'updatedAt']);
      allow create: if signedIn()
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId != uid()
        && (!('actorId' in request.resource.data) || request.resource.data.actorId == uid() || request.resource.data.actorId == null)
        && (!('senderId' in request.resource.data) || request.resource.data.senderId == uid() || request.resource.data.senderId == null);
    }

    match /reports/{reportId} {
      allow read, update, delete: if isModerator();
      allow create: if owns('reporterId');
    }

    match /messages/{conversationId} {
      allow read, delete: if signedIn() && (uid() in resource.data.participants || isModerator());
      allow create: if signedIn() && uid() in request.resource.data.participants;
      allow update: if signedIn() && (uid() in resource.data.participants || uid() in request.resource.data.participants || isModerator());

      match /messages/{messageId} {
        allow read: if signedIn()
          && (uid() in get(/databases/$(database)/documents/messages/$(conversationId)).data.participants || isModerator());
        allow create: if signedIn()
          && request.resource.data.senderId == uid()
          && uid() in get(/databases/$(database)/documents/messages/$(conversationId)).data.participants;
        allow update: if signedIn()
          && (resource.data.senderId == uid()
              || resource.data.recipientId == uid()
              || uid() in get(/databases/$(database)/documents/messages/$(conversationId)).data.participants
              || isModerator());
        allow delete: if signedIn()
          && (resource.data.senderId == uid() || isModerator());
      }
    }

    match /hubConversations/{conversationId} {
      function isComrade() {
        return resource.data.category == 'comrade';
      }
      function isGroup() {
        return resource.data.category == 'group' || ('isGroup' in resource.data && resource.data.isGroup == true);
      }
      function otherComradeId(participants) {
        return participants[0] == uid() ? participants[1] : participants[0];
      }

      allow read: if signedIn() && (
        (isComrade() && uid() in resource.data.participantIds && isAcceptedConnection(otherComradeId(resource.data.participantIds)))
        || (isGroup() && uid() in resource.data.memberIds)
        || isModerator()
      );

      allow create: if signedIn() && (
        (request.resource.data.category == 'comrade'
         && uid() in request.resource.data.participantIds
         && isAcceptedConnection(otherComradeId(request.resource.data.participantIds)))
        || (request.resource.data.category == 'group' && uid() in request.resource.data.memberIds)
        || isModerator()
      );

      allow update: if signedIn() && (
        (isComrade() && uid() in resource.data.participantIds && isAcceptedConnection(otherComradeId(resource.data.participantIds)))
        || (isGroup() && uid() in resource.data.memberIds)
        || isModerator()
      );

      allow delete: if signedIn() && (
        (isComrade() && uid() in resource.data.participantIds)
        || (isGroup() && resource.data.ownerId == uid())
        || isModerator()
      );

      match /messages/{messageId} {
        function parentHubConvo() {
          return get(/databases/$(database)/documents/hubConversations/$(conversationId)).data;
        }

        function otherParentComrade() {
          return parentHubConvo().participantIds[0] == uid() ? parentHubConvo().participantIds[1] : parentHubConvo().participantIds[0];
        }

        allow read: if signedIn() && (
          (parentHubConvo().category == 'comrade'
           && uid() in parentHubConvo().participantIds
           && isAcceptedConnection(otherParentComrade()))
          || (parentHubConvo().category == 'group' && uid() in parentHubConvo().memberIds)
          || isModerator()
        );

        allow create: if signedIn()
          && request.resource.data.senderId == uid()
          && (
            (parentHubConvo().category == 'comrade'
             && uid() in parentHubConvo().participantIds
             && isAcceptedConnection(otherParentComrade()))
            || (parentHubConvo().category == 'group' && uid() in parentHubConvo().memberIds)
            || isModerator()
          );

        allow update, delete: if signedIn() && (
          resource.data.senderId == uid() || isModerator()
        );
      }
    }

    match /platformConfig/{configId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /teams/{teamId} {
      allow get: if true;
      allow list: if signedIn() && (
        ('memberIds' in resource.data && uid() in resource.data.memberIds)
        || resource.data.ownerId == uid()
        || isModerator()
      );
      allow create: if signedIn() && request.resource.data.ownerId == uid() && uid() in request.resource.data.memberIds;
      allow update: if signedIn() && (
        (resource.data.ownerId == uid() && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId'])
          || (request.resource.data.ownerId is string && request.resource.data.ownerId in resource.data.memberIds)
        ))
        || (('memberIds' in resource.data && uid() in resource.data.memberIds)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageSenderId', 'lastMessageSenderName', 'lastMessageTimestamp', 'updatedAt']))
        || (('memberIds' in resource.data && uid() in resource.data.memberIds)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'memberCount', 'updatedAt']))
        || (!('memberIds' in resource.data) || !(uid() in resource.data.memberIds))
        || isModerator()
      );
      allow delete: if signedIn() && (resource.data.ownerId == uid() || isModerator());

      match /members/{memberId} {
        allow read: if signedIn() && (
          uid() in get(/databases/$(database)/documents/teams/$(teamId)).data.memberIds
          || get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId == uid()
          || isModerator()
        );
        allow create: if signedIn() && (
          memberId == uid()
          || get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId == uid()
          || isModerator()
        );
        allow update: if signedIn() && (
          get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId == uid()
          || (memberId == uid() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReadAt']))
          || isModerator()
        );
        allow delete: if signedIn() && (
          memberId == uid()
          || get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId == uid()
          || isModerator()
        );
      }

      match /messages/{messageId} {
        allow read: if signedIn() && (
          uid() in get(/databases/$(database)/documents/teams/$(teamId)).data.memberIds
          || isModerator()
        );
        allow create: if signedIn()
          && request.resource.data.senderId == uid()
          && uid() in get(/databases/$(database)/documents/teams/$(teamId)).data.memberIds;
        allow update: if signedIn() && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
          || resource.data.senderId == uid()
          || isModerator()
        );
        allow delete: if signedIn() && (
          resource.data.senderId == uid()
          || get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId == uid()
          || isModerator()
        );
      }

      match /joinRequests/{requestId} {
        allow read: if signedIn() && (
          requestId == uid()
          || resource.data.userId == uid()
          || get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId == uid()
          || isModerator()
        );
        allow create: if signedIn()
          && (requestId == uid() || request.resource.data.userId == uid())
          && request.resource.data.teamId == teamId
          && request.resource.data.status == 'PENDING';
        allow update: if signedIn() && (
          get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId == uid()
          || isModerator()
          || (resource.data.userId == uid()
              && request.resource.data.status == 'CANCELLED'
              && resource.data.status == 'PENDING'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
        );
        allow delete: if signedIn() && (
          resource.data.userId == uid()
          || get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId == uid()
          || isModerator()
        );
      }
    }

    match /teamInvitations/{token} {
      allow get: if true;
      allow list: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == uid();
      allow update: if signedIn() && (
        resource.data.createdBy == uid()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount', 'usedBy', 'updatedAt'])
        || isModerator()
      );
      allow delete: if signedIn() && (resource.data.createdBy == uid() || isModerator());
    }
  }
}
