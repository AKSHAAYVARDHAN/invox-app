rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function currentUser() {
      return get(userPath(uid())).data;
    }

    function hasRole(role) {
      return signedIn()
        && exists(userPath(uid()))
        && currentUser().role == role;
    }

    function isModerator() {
      return hasRole('moderator') || isAdmin();
    }

    function isAdmin() {
      return (signedIn() && exists(userPath(uid())) && currentUser().role == 'admin')
        || (signedIn()
            && request.auth.token.email_verified == true
            && request.auth.token.email in ['akshaayvardhans@gmail.com']);
    }

    function isValidTrendId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidHttpUrl(url) {
      return url is string && url.size() > 0 && url.size() <= 2048 && url.matches('^https?://.+');
    }

    function isValidTrendDomainSlug(slug) {
      return slug is string && slug in [
        'technology',
        'health-care',
        'trading',
        'stock-market',
        'design',
        'finance',
        'science',
        'gaming',
        'art',
        'automotive',
        'space'
      ];
    }

    function isValidFollowedTrendDomains(data) {
      return !('followedTrendDomains' in data)
        || (
          data.followedTrendDomains is list
          && data.followedTrendDomains.size() <= 20
          && data.followedTrendDomains.hasOnly([
            'technology',
            'health-care',
            'trading',
            'stock-market',
            'design',
            'finance',
            'science',
            'gaming',
            'art',
            'automotive',
            'space'
          ])
        );
    }

    function isValidTrendStats(stats) {
      return stats is map
        && stats.keys().hasAll(['likes', 'views', 'comments', 'saves', 'shares'])
        && stats.keys().hasOnly(['likes', 'views', 'comments', 'saves', 'shares'])
        && stats.likes is int && stats.likes >= 0
        && stats.views is int && stats.views >= 0
        && stats.comments is int && stats.comments >= 0
        && stats.saves is int && stats.saves >= 0
        && stats.shares is int && stats.shares >= 0;
    }

    function isValidTrendSource(source) {
      return source is map
        && source.keys().hasAll(['name', 'domain', 'url', 'urlHash', 'credibilityTier'])
        && source.keys().hasOnly(['name', 'domain', 'url', 'urlHash', 'author', 'credibilityTier'])
        && source.name is string && source.name.size() > 0 && source.name.size() <= 160
        && source.domain is string && source.domain.size() > 0 && source.domain.size() <= 255
        && isValidHttpUrl(source.url)
        && source.urlHash is string && source.urlHash.size() >= 16 && source.urlHash.size() <= 128
        && source.credibilityTier in ['primary', 'reputable', 'trade']
        && (!('author' in source) || (source.author is string && source.author.size() <= 160));
    }

    function isValidTrendMedia(media) {
      return media is map
        && media.keys().hasAll(['type', 'url', 'origin'])
        && media.keys().hasOnly(['type', 'url', 'thumbnailUrl', 'overlayUrl', 'origin', 'attribution', 'storagePath'])
        && media.type in ['image', 'video']
        && isValidHttpUrl(media.url)
        && media.origin in ['source_og', 'ai_generated', 'domain_fallback']
        && (!('thumbnailUrl' in media) || isValidHttpUrl(media.thumbnailUrl))
        && (!('overlayUrl' in media) || (media.overlayUrl is string && media.overlayUrl.size() <= 2048))
        && (!('attribution' in media) || (media.attribution is string && media.attribution.size() <= 300))
        && (!('storagePath' in media) || (media.storagePath is string && media.storagePath.size() <= 512));
    }

    function isValidTrendRecord(data, trendId) {
      return data.keys().hasAll([
          'id',
          'slug',
          'status',
          'domainSlug',
          'domain',
          'category',
          'tags',
          'searchKeywords',
          'title',
          'summary',
          'fullContent',
          'keyTakeaways',
          'source',
          'publishedAt',
          'discoveredAt',
          'createdAt',
          'updatedAt',
          'media',
          'momentumScore',
          'relatedTrendIds',
          'stats',
          'schemaVersion'
        ])
        && data.keys().hasOnly([
          'id',
          'slug',
          'status',
          'domainSlug',
          'domain',
          'category',
          'tags',
          'searchKeywords',
          'title',
          'summary',
          'fullContent',
          'keyTakeaways',
          'source',
          'additionalSources',
          'publishedAt',
          'discoveredAt',
          'createdAt',
          'updatedAt',
          'media',
          'momentumScore',
          'relatedTrendIds',
          'stats',
          'schemaVersion',
          'aiModel',
          'contentHash',
          'language',
          'region',
          'whyItMatters',
          'sourceRetrievedAt',
          'ingestionRunId',
          'ingestionItemId',
          'reviewedBy',
          'reviewedAt',
          'groundingStatus'
        ])
        && data.id is string && data.id == trendId && isValidTrendId(data.id)
        && data.slug is string && data.slug.size() > 0 && data.slug.size() <= 160 && data.slug.matches('^[a-z0-9\\-]+$')
        && data.status is string && data.status in ['draft', 'published', 'archived', 'flagged']
        && isValidTrendDomainSlug(data.domainSlug)
        && data.domain is string && data.domain.size() > 0 && data.domain.size() <= 80
        && data.category is string && data.category.size() > 0 && data.category.size() <= 80
        && data.tags is list && data.tags.size() <= 10 && (data.tags.size() == 0 || data.tags[0] is string)
        && data.searchKeywords is list && data.searchKeywords.size() <= 40 && (data.searchKeywords.size() == 0 || data.searchKeywords[0] is string)
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 240
        && data.summary is string && data.summary.size() >= 10 && data.summary.size() <= 1200
        && data.fullContent is string && data.fullContent.size() >= 10 && data.fullContent.size() <= 20000
        && data.keyTakeaways is list && data.keyTakeaways.size() <= 10 && (data.keyTakeaways.size() == 0 || data.keyTakeaways[0] is string)
        && isValidTrendSource(data.source)
        && (!('additionalSources' in data) || (data.additionalSources is list && data.additionalSources.size() <= 10))
        && data.publishedAt is timestamp
        && data.discoveredAt is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && isValidTrendMedia(data.media)
        && data.momentumScore is number && data.momentumScore >= 0
        && data.relatedTrendIds is list && data.relatedTrendIds.size() <= 10 && (data.relatedTrendIds.size() == 0 || data.relatedTrendIds[0] is string)
        && isValidTrendStats(data.stats)
        && data.schemaVersion is int && data.schemaVersion >= 1
        && (!('aiModel' in data) || (data.aiModel is string && data.aiModel.size() <= 100))
        && (!('contentHash' in data) || (data.contentHash is string && data.contentHash.size() <= 128))
        && (!('language' in data) || (data.language is string && data.language.size() <= 16))
        && (!('region' in data) || (data.region is string && data.region.size() <= 64))
        && (!('whyItMatters' in data) || (data.whyItMatters is string && data.whyItMatters.size() <= 1200))
        && (!('sourceRetrievedAt' in data) || data.sourceRetrievedAt is timestamp)
        && (!('ingestionRunId' in data) || (data.ingestionRunId is string && data.ingestionRunId.size() <= 128))
        && (!('ingestionItemId' in data) || (data.ingestionItemId is string && data.ingestionItemId.size() <= 128))
        && (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 128))
        && (!('reviewedAt' in data) || data.reviewedAt is timestamp)
        && (!('groundingStatus' in data) || (data.groundingStatus is string && data.groundingStatus in ['verified', 'needs_review']));
    }

    function isValidTrendIngestionStage(stage) {
      return stage is string && stage in [
        'DISCOVERED',
        'VALIDATING',
        'VALIDATED',
        'PROCESSING',
        'PENDING_REVIEW',
        'APPROVED',
        'PUBLISHED',
        'REJECTED',
        'FAILED'
      ];
    }

    function isValidTrendIngestionRun(data, runId) {
      return data.keys().hasAll([
          'id',
          'status',
          'triggeredBy',
          'triggerMode',
          'domains',
          'windowHours',
          'maxItemsPerDomain',
          'providerIds',
          'counts',
          'errors',
          'startedAt'
        ])
        && data.id is string && data.id == runId && isValidTrendId(data.id)
        && data.status is string && data.status in ['running', 'completed', 'partial_failure', 'failed']
        && data.triggeredBy is string && data.triggeredBy.size() > 0 && data.triggeredBy.size() <= 128
        && data.triggerMode is string && data.triggerMode in ['manual', 'single_url', 'scheduled']
        && data.domains is list && data.domains.size() <= 20
        && data.windowHours is number && data.windowHours >= 1 && data.windowHours <= 720
        && data.maxItemsPerDomain is int && data.maxItemsPerDomain >= 1 && data.maxItemsPerDomain <= 25
        && data.providerIds is list && data.providerIds.size() <= 20
        && data.counts is map
        && data.errors is list && data.errors.size() <= 100
        && data.startedAt is string && data.startedAt.size() <= 64;
    }

    function isValidTrendIngestionItem(data, itemId) {
      return data.keys().hasAll([
          'id',
          'runId',
          'stage',
          'stageHistory',
          'domainSlug',
          'providerId',
          'providerName',
          'source',
          'corroboratingSources',
          'media',
          'retryCount',
          'createdAtIso',
          'updatedAtIso'
        ])
        && data.id is string && data.id == itemId && isValidTrendId(data.id)
        && data.runId is string && isValidTrendId(data.runId)
        && isValidTrendIngestionStage(data.stage)
        && data.stageHistory is list && data.stageHistory.size() <= 40
        && isValidTrendDomainSlug(data.domainSlug)
        && data.providerId is string && data.providerId.size() > 0 && data.providerId.size() <= 80
        && data.providerName is string && data.providerName.size() > 0 && data.providerName.size() <= 120
        && data.source is map
        && data.corroboratingSources is list && data.corroboratingSources.size() <= 15
        && isValidTrendMedia(data.media)
        && data.retryCount is int && data.retryCount >= 0 && data.retryCount <= 20
        && data.createdAtIso is string && data.createdAtIso.size() <= 64
        && data.updatedAtIso is string && data.updatedAtIso.size() <= 64;
    }

    function isPublishedTrend(trendId) {
      return isValidTrendId(trendId)
        && exists(/databases/$(database)/documents/trendz/$(trendId))
        && get(/databases/$(database)/documents/trendz/$(trendId)).data.status == 'published';
    }

    function isValidTrendLikeDoc(data, likeId) {
      return data.keys().hasAll(['userId', 'targetType', 'targetId', 'domainSlug', 'createdAt'])
        && data.keys().hasOnly(['userId', 'targetType', 'targetId', 'domainSlug', 'createdAt'])
        && data.userId == uid()
        && data.targetType == 'trendz'
        && isValidTrendId(data.targetId)
        && likeId == uid() + '_trendz_' + data.targetId
        && isValidTrendDomainSlug(data.domainSlug)
        && data.createdAt == request.time;
    }

    function isValidTrendBookmarkDoc(data, bookmarkId) {
      return data.keys().hasAll([
          'userId',
          'targetType',
          'targetId',
          'domainSlug',
          'trendTitle',
          'trendSummary',
          'trendPublisher',
          'trendPublishedOn',
          'trendMediaUrl',
          'trendMediaType',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'targetType',
          'targetId',
          'domainSlug',
          'trendTitle',
          'trendSummary',
          'trendPublisher',
          'trendPublishedOn',
          'trendMediaUrl',
          'trendMediaType',
          'createdAt'
        ])
        && data.userId == uid()
        && data.targetType == 'trendz'
        && isValidTrendId(data.targetId)
        && bookmarkId == uid() + '_trendz_' + data.targetId
        && isValidTrendDomainSlug(data.domainSlug)
        && data.trendTitle is string && data.trendTitle.size() > 0 && data.trendTitle.size() <= 240
        && data.trendSummary is string && data.trendSummary.size() <= 500
        && data.trendPublisher is string && data.trendPublisher.size() > 0 && data.trendPublisher.size() <= 160
        && data.trendPublishedOn is string && data.trendPublishedOn.size() <= 32
        && data.trendMediaUrl is string && data.trendMediaUrl.size() <= 2048
        && data.trendMediaType in ['image', 'video']
        && data.createdAt == request.time;
    }

    function isValidTrendViewDoc(data, userId, trendId) {
      return data.keys().hasAll(['userId', 'trendId', 'domainSlug', 'viewedAt'])
        && data.keys().hasOnly(['userId', 'trendId', 'domainSlug', 'viewedAt'])
        && userId == uid()
        && data.userId == uid()
        && isValidTrendId(trendId)
        && data.trendId == trendId
        && isValidTrendDomainSlug(data.domainSlug)
        && data.viewedAt == request.time;
    }

    function isValidTrendEngagementStatsUpdate(trendId) {
      return signedIn()
        && isValidTrendId(trendId)
        && resource.data.status == 'published'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stats'])
        && isValidTrendStats(request.resource.data.stats)
        && request.resource.data.stats.comments == resource.data.stats.comments
        && request.resource.data.stats.shares == resource.data.stats.shares
        && (
          // Atomic upvote create (+1)
          (
            request.resource.data.stats.likes == resource.data.stats.likes + 1
            && request.resource.data.stats.saves == resource.data.stats.saves
            && request.resource.data.stats.views == resource.data.stats.views
            && !exists(/databases/$(database)/documents/likes/$(uid() + '_trendz_' + trendId))
            && existsAfter(/databases/$(database)/documents/likes/$(uid() + '_trendz_' + trendId))
          )
          // Atomic upvote delete (-1, clamped >= 0)
          || (
            ((resource.data.stats.likes > 0 && request.resource.data.stats.likes == resource.data.stats.likes - 1)
              || (resource.data.stats.likes == 0 && request.resource.data.stats.likes == 0))
            && request.resource.data.stats.saves == resource.data.stats.saves
            && request.resource.data.stats.views == resource.data.stats.views
            && exists(/databases/$(database)/documents/likes/$(uid() + '_trendz_' + trendId))
            && !existsAfter(/databases/$(database)/documents/likes/$(uid() + '_trendz_' + trendId))
          )
          // Atomic bookmark create (+1)
          || (
            request.resource.data.stats.saves == resource.data.stats.saves + 1
            && request.resource.data.stats.likes == resource.data.stats.likes
            && request.resource.data.stats.views == resource.data.stats.views
            && !exists(/databases/$(database)/documents/bookmarks/$(uid() + '_trendz_' + trendId))
            && existsAfter(/databases/$(database)/documents/bookmarks/$(uid() + '_trendz_' + trendId))
          )
          // Atomic bookmark delete (-1, clamped >= 0)
          || (
            ((resource.data.stats.saves > 0 && request.resource.data.stats.saves == resource.data.stats.saves - 1)
              || (resource.data.stats.saves == 0 && request.resource.data.stats.saves == 0))
            && request.resource.data.stats.likes == resource.data.stats.likes
            && request.resource.data.stats.views == resource.data.stats.views
            && exists(/databases/$(database)/documents/bookmarks/$(uid() + '_trendz_' + trendId))
            && !existsAfter(/databases/$(database)/documents/bookmarks/$(uid() + '_trendz_' + trendId))
          )
          // Atomic first-time user view (+1, deduplicated via /users/{uid}/trendViews/{trendId})
          || (
            request.resource.data.stats.views == resource.data.stats.views + 1
            && request.resource.data.stats.likes == resource.data.stats.likes
            && request.resource.data.stats.saves == resource.data.stats.saves
            && !exists(/databases/$(database)/documents/users/$(uid())/trendViews/$(trendId))
            && existsAfter(/databases/$(database)/documents/users/$(uid())/trendViews/$(trendId))
          )
        );
    }

    function owns(field) {
      return signedIn() && request.resource.data[field] == uid();
    }

    function existingOwner(field) {
      return signedIn() && resource.data[field] == uid();
    }

    // Canonical accepted (mutual) connection check between current user and target user
    function isAcceptedConnection(targetUserId) {
  let currentFollowId = uid() + '_' + targetUserId;
  let reverseFollowId = targetUserId + '_' + uid();

  return signedIn() && (
    targetUserId == uid() ||
    (
      exists(/databases/$(database)/documents/follows/$(currentFollowId))
      && exists(/databases/$(database)/documents/follows/$(reverseFollowId))
    )
  );
}

    // Identifies whether post document is Hub content (Moments or Loops)
    function isHubPostData(data) {
      return ('isHub' in data && data.isHub == true)
        || ('type' in data && (data.type == 'Moment' || data.type == 'Loop' || data.type == 'still' || data.type == 'tape' || data.type == 'knack'))
        || ('postType' in data && (data.postType == 'Moment' || data.postType == 'Loop'))
        || ('momentType' in data && data.momentType != null)
        || ('isLoop' in data && data.isLoop == true);
    }

    function protectedUserFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'uid',
        'role',
        'followerCount',
        'followingCount',
        'savedPostCount',
        'savedProjectCount',
        'savedOpportunityCount',
        'reputation',
        'createdAt'
      ]);
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && userId == uid()
        && request.resource.data.uid == uid()
        && request.resource.data.role == 'user'
        && isValidFollowedTrendDomains(request.resource.data);
      allow update: if isAdmin() || (
        signedIn()
        && userId == uid()
        && !protectedUserFieldsChanged()
        && isValidFollowedTrendDomains(request.resource.data)
      );
      allow delete: if isAdmin();

      match /sparkConversations/{conversationId} {
        allow get, create, update, delete: if signedIn() && userId == uid() && isValidTrendId(conversationId);
        allow list: if signedIn() && userId == uid();
      }

      match /trendViews/{trendId} {
        allow get: if signedIn() && userId == uid() && isValidTrendId(trendId);
        allow list: if signedIn() && userId == uid();
        allow create: if signedIn()
          && userId == uid()
          && isValidTrendId(trendId)
          && isValidTrendViewDoc(request.resource.data, userId, trendId)
          && isPublishedTrend(trendId);
        allow update: if false;
        allow delete: if signedIn() && userId == uid() && isValidTrendId(trendId);
      }

      match /trendzPreferences/{docId} {
        allow get: if signedIn() && userId == uid() && docId == 'domains';
        allow list: if signedIn() && userId == uid();
        allow create, update: if signedIn()
          && userId == uid()
          && docId == 'domains'
          && request.resource.data.keys().hasAll(['followedDomainSlugs', 'uid', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['followedDomainSlugs', 'uid', 'updatedAt'])
          && request.resource.data.uid == uid()
          && request.resource.data.followedDomainSlugs is list
          && request.resource.data.followedDomainSlugs.size() <= 20
          && request.resource.data.followedDomainSlugs.hasOnly([
               'technology', 'health-care', 'trading', 'stock-market',
               'design', 'finance', 'science', 'gaming', 'art', 'automotive', 'space'
             ])
          && request.resource.data.updatedAt == request.time;
        allow delete: if signedIn() && userId == uid() && docId == 'domains';
      }

      function trendzAiConversationPath(conversationId) {
        return /databases/$(database)/documents/users/$(userId)/trendzAiConversations/$(conversationId);
      }

      function isValidTrendAiConversationDoc(data, conversationId) {
        return data.keys().hasAll([
            'id', 'userId', 'trendId', 'trendTitle', 'trendDomainSlug',
            'trendDomainName', 'trendPublisher', 'title', 'lastMessagePreview',
            'messageCount', 'memorySummary', 'summarizedMessageCount',
            'createdAt', 'updatedAt'
          ])
          && data.keys().hasOnly([
            'id', 'userId', 'trendId', 'trendTitle', 'trendDomainSlug',
            'trendDomainName', 'trendPublisher', 'title', 'lastMessagePreview',
            'messageCount', 'memorySummary', 'summarizedMessageCount',
            'createdAt', 'updatedAt'
          ])
          && data.id == conversationId
          && data.userId == userId
          && isValidTrendId(data.trendId)
          && data.trendTitle is string && data.trendTitle.size() > 0 && data.trendTitle.size() <= 240
          && isValidTrendDomainSlug(data.trendDomainSlug)
          && data.trendDomainName is string && data.trendDomainName.size() > 0 && data.trendDomainName.size() <= 80
          && data.trendPublisher is string && data.trendPublisher.size() > 0 && data.trendPublisher.size() <= 160
          && data.title is string && data.title.size() > 0 && data.title.size() <= 140
          && data.lastMessagePreview is string && data.lastMessagePreview.size() <= 240
          && data.messageCount is int && data.messageCount >= 0 && data.messageCount <= 1000
          && data.memorySummary is string && data.memorySummary.size() <= 3000
          && data.summarizedMessageCount is int && data.summarizedMessageCount >= 0 && data.summarizedMessageCount <= data.messageCount
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
      }

      function isValidTrendAiGroundingMap(g) {
        return g is map
          && g.keys().hasAll([
            'verificationStatus', 'verificationScope', 'excerptCompleteness',
            'evidenceSufficiency', 'evidenceWarnings', 'isSimulated', 'sourceAttribution'
          ])
          && g.keys().hasOnly([
            'verificationStatus', 'verificationScope', 'excerptCompleteness',
            'evidenceSufficiency', 'evidenceWarnings', 'isSimulated', 'sourceAttribution'
          ])
          && g.verificationStatus in ['verified', 'unavailable', 'unverified']
          && g.verificationScope == 'url_reachability_only'
          && g.excerptCompleteness in ['full_excerpt', 'truncated', 'unavailable']
          && g.evidenceSufficiency in ['strong', 'partial', 'limited']
          && g.evidenceWarnings is list && g.evidenceWarnings.size() <= 8
          && g.isSimulated is bool
          && g.sourceAttribution is map
          && g.sourceAttribution.keys().hasAll(['publisherName', 'sourceDomain', 'originalUrl', 'canonicalUrl'])
          && g.sourceAttribution.keys().hasOnly(['publisherName', 'sourceDomain', 'originalUrl', 'canonicalUrl'])
          && g.sourceAttribution.publisherName is string && g.sourceAttribution.publisherName.size() > 0 && g.sourceAttribution.publisherName.size() <= 160
          && (g.sourceAttribution.sourceDomain == null || (g.sourceAttribution.sourceDomain is string && g.sourceAttribution.sourceDomain.size() <= 255))
          && (g.sourceAttribution.originalUrl == null || isValidHttpUrl(g.sourceAttribution.originalUrl))
          && (g.sourceAttribution.canonicalUrl == null || isValidHttpUrl(g.sourceAttribution.canonicalUrl));
      }

      function isValidTrendAiEvidenceAssessment(ea) {
        return ea is map
          && ea.keys().hasAll([
            'groundingBasis', 'citedSourceCount', 'citedEditorialCount',
            'retrievedEvidenceCount', 'hasDirectSourceExcerpts'
          ])
          && ea.keys().hasOnly([
            'groundingBasis', 'citedSourceCount', 'citedEditorialCount',
            'retrievedEvidenceCount', 'hasDirectSourceExcerpts'
          ])
          && ea.groundingBasis in ['source_cited', 'editorial_cited', 'source_available_uncited', 'limited_evidence']
          && ea.citedSourceCount is int && ea.citedSourceCount >= 0 && ea.citedSourceCount <= 16
          && ea.citedEditorialCount is int && ea.citedEditorialCount >= 0 && ea.citedEditorialCount <= 16
          && ea.retrievedEvidenceCount is int && ea.retrievedEvidenceCount >= 0 && ea.retrievedEvidenceCount <= 16
          && ea.hasDirectSourceExcerpts is bool;
      }

      function isValidTrendAiMessageDoc(data, conversationId, messageId) {
        return data.keys().hasAll([
            'id', 'conversationId', 'userId', 'trendId', 'role',
            'text', 'status', 'sequence', 'createdAt'
          ])
          && data.keys().hasOnly([
            'id', 'conversationId', 'userId', 'trendId', 'role',
            'text', 'status', 'sequence', 'clientMessageId', 'model',
            'grounding', 'citations', 'evidenceAssessment', 'createdAt'
          ])
          && data.id == messageId
          && data.conversationId == conversationId
          && data.userId == userId
          && isValidTrendId(data.trendId)
          && data.role in ['user', 'assistant']
          && data.text is string && data.text.size() > 0 && data.text.size() <= 16000
          && data.status in ['complete', 'partial', 'error']
          && data.sequence is int && data.sequence >= 0 && data.sequence <= 10000
          && (!('clientMessageId' in data) || (data.clientMessageId is string && data.clientMessageId.size() > 0 && data.clientMessageId.size() <= 128))
          && (!('model' in data) || (data.model is string && data.model.size() > 0 && data.model.size() <= 100))
          && (!('grounding' in data) || isValidTrendAiGroundingMap(data.grounding))
          && (!('citations' in data) || (data.citations is list && data.citations.size() <= 8))
          && (!('evidenceAssessment' in data) || isValidTrendAiEvidenceAssessment(data.evidenceAssessment))
          && data.createdAt is timestamp;
      }

      match /trendzAiConversations/{conversationId} {
        allow get: if signedIn() && userId == uid() && isValidTrendId(conversationId);
        allow list: if signedIn() && userId == uid();
        allow create: if signedIn()
          && userId == uid()
          && isValidTrendId(conversationId)
          && isValidTrendAiConversationDoc(request.resource.data, conversationId)
          && isPublishedTrend(request.resource.data.trendId);
        allow update: if signedIn()
          && userId == uid()
          && isValidTrendId(conversationId)
          && isValidTrendAiConversationDoc(request.resource.data, conversationId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.trendId == resource.data.trendId
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if signedIn() && userId == uid() && isValidTrendId(conversationId);

        match /messages/{messageId} {
          allow get: if signedIn()
            && userId == uid()
            && isValidTrendId(conversationId)
            && isValidTrendId(messageId)
            && exists(trendzAiConversationPath(conversationId))
            && get(trendzAiConversationPath(conversationId)).data.userId == uid();
          allow list: if signedIn()
            && userId == uid()
            && isValidTrendId(conversationId)
            && exists(trendzAiConversationPath(conversationId))
            && get(trendzAiConversationPath(conversationId)).data.userId == uid();
          allow create: if signedIn()
            && userId == uid()
            && isValidTrendId(conversationId)
            && isValidTrendId(messageId)
            && exists(trendzAiConversationPath(conversationId))
            && get(trendzAiConversationPath(conversationId)).data.userId == uid()
            && request.resource.data.trendId == get(trendzAiConversationPath(conversationId)).data.trendId
            && isValidTrendAiMessageDoc(request.resource.data, conversationId, messageId);
          allow update: if false;
          allow delete: if signedIn()
            && userId == uid()
            && isValidTrendId(conversationId)
            && isValidTrendId(messageId)
            && (!exists(trendzAiConversationPath(conversationId))
                || get(trendzAiConversationPath(conversationId)).data.userId == uid());
        }
      }
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == uid();
      allow update: if signedIn() && resource.data.uid == uid() && request.resource.data.uid == uid();
      allow delete: if signedIn() && resource.data.uid == uid();
    }

    match /channels/{channelId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == uid();
      allow update, delete: if signedIn() && (resource.data.ownerId == uid() || isModerator());
    }

    match /posts/{postId} {
      // Hub content (Moments & Loops) is strictly private to author and accepted connections
      allow get: if !isHubPostData(resource.data)
        || (signedIn() && (resource.data.authorId == uid() || isAcceptedConnection(resource.data.authorId) || isModerator()));

      allow list: if signedIn() && (
        (!isHubPostData(resource.data))
        || (resource.data.authorId == uid())
        || (isAcceptedConnection(resource.data.authorId))
        || isModerator()
      );

      allow create: if signedIn()
        && request.resource.data.authorId == uid()
        && (
          (request.resource.data.type == 'Feed' || request.resource.data.postType == 'Feed' || request.resource.data.channelId != null)
            ? (request.resource.data.channelId is string
               && exists(/databases/$(database)/documents/channels/$(request.resource.data.channelId))
               && get(/databases/$(database)/documents/channels/$(request.resource.data.channelId)).data.ownerId == uid())
            : true
        );

      allow update: if signedIn() && (
        (('authorId' in resource.data) && resource.data.authorId == uid())
        || isModerator()
        // Community Owner or Admin can update proposal lifecycle, decisions, and consultations
        || (('communityId' in resource.data) && isCommunityOwnerOrAdmin(resource.data.communityId))
        || (
          // Stat/reaction updates on Hub posts require accepted connection
          (!isHubPostData(resource.data) || isAcceptedConnection(resource.data.authorId))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stats', 'likeCount', 'viewCount', 'commentCount', 'saveCount', 'strikeCount', 'strikes', 'updatedAt', 'pollMeta', 'consultationMeta', 'decisionMeta'])
        )
      );
      allow delete: if signedIn() && ((('authorId' in resource.data) && resource.data.authorId == uid()) || isModerator());
    }

    match /polls/{pollId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == uid();
      allow update: if signedIn() && (
        ('authorId' in resource.data && resource.data.authorId == uid())
        || isModerator()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalVotes', 'options', 'stats', 'likeCount', 'viewCount', 'commentCount', 'updatedAt'])
      );
      allow delete: if signedIn() && (('authorId' in resource.data && resource.data.authorId == uid()) || isModerator());

      match /votes/{userId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && userId == uid() && request.resource.data.userId == uid();
        allow delete: if signedIn() && userId == uid();
      }
    }

    match /projects/{projectId} {
      allow read: if signedIn() && (resource.data.status == 'published' || resource.data.authorId == uid() || isModerator());
      allow create: if owns('authorId');
      allow update, delete: if existingOwner('authorId') || isModerator();
    }

    match /trendz/{trendId} {
      // Signed-in users can read published trends (or check non-existent deleted IDs cleanly); moderators/admins may also inspect drafts/archived/flagged items.
      allow get: if signedIn() && isValidTrendId(trendId) && (resource == null || resource.data.status == 'published' || isModerator());
      allow list: if signedIn() && (resource.data.status == 'published' || isModerator());

      // Publishing and editorial updates are strictly restricted to moderators/admins (and trusted backend Admin SDK).
      // Regular users have zero write permissions; client-side updates cannot tamper with immutable fields or engagement aggregates.
      allow create: if isModerator()
        && isValidTrendId(trendId)
        && isValidTrendRecord(request.resource.data, trendId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if (
        isModerator()
        && isValidTrendId(trendId)
        && isValidTrendRecord(request.resource.data, trendId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.discoveredAt == resource.data.discoveredAt
        && request.resource.data.updatedAt == request.time
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'id',
          'createdAt',
          'discoveredAt',
          'stats',
          'momentumScore'
        ])
      ) || isValidTrendEngagementStatsUpdate(trendId);

      allow delete: if isAdmin() && isValidTrendId(trendId);
    }

    // Trendz ingestion registries & editorial review queue — strictly restricted to admins/moderators.
    // Ordinary users have zero read or write access to unreviewed sources, pipeline runs, or review items.
    match /trendSources/{sourceId} {
      allow read: if isModerator();
      allow create, update: if isModerator() && isValidTrendId(sourceId);
      allow delete: if isAdmin() && isValidTrendId(sourceId);
    }

    match /trendIngestionRuns/{runId} {
      allow read: if isModerator();
      allow create, update: if isModerator()
        && isValidTrendId(runId)
        && isValidTrendIngestionRun(request.resource.data, runId);
      allow delete: if isAdmin() && isValidTrendId(runId);
    }

    match /trendIngestionItems/{itemId} {
      allow read: if isModerator();
      allow create, update: if isModerator()
        && isValidTrendId(itemId)
        && isValidTrendIngestionItem(request.resource.data, itemId);
      allow delete: if isAdmin() && isValidTrendId(itemId);
    }

    match /communities/{communityId} {
      allow read: if true;
      allow create: if signedIn() && (
        (request.resource.data.ownerId == uid()) ||
        (request.resource.data.creatorId == uid()) ||
        isModerator()
      );
      allow update: if signedIn() && (
        // Community Owner or Creator can update
        ((resource.data.ownerId == uid()) || (resource.data.creatorId == uid()))
        // Explicit Community Administrator can update content/settings, but CANNOT alter ownership or adminIds
        || (
          (('adminIds' in resource.data) && (uid() in resource.data.adminIds))
          && (!('ownerId' in request.resource.data) || request.resource.data.ownerId == resource.data.ownerId)
          && (!('creatorId' in request.resource.data) || request.resource.data.creatorId == resource.data.creatorId)
          && (!('adminIds' in request.resource.data) || request.resource.data.adminIds == resource.data.adminIds)
        )
        // Public counters
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'members', 'updatedAt'])
        // Platform Moderator fallback
        || isModerator()
      );
      allow delete: if signedIn() && (
        resource.data.ownerId == uid() ||
        resource.data.creatorId == uid() ||
        isModerator()
      );

      // Private anonymized Community Health aggregate snapshots:
      // Strictly restricted to community owner/creator or explicit community admins.
      // Regular members and non-members have zero read/write access.
      match /healthSnapshots/{snapshotId} {
        allow get, list: if isCommunityOwnerOrAdmin(communityId) || isModerator();
        allow create, update: if isValidCommunityHealthId(snapshotId)
          && isCommunityOwnerOrAdmin(communityId)
          && isValidCommunityHealthSnapshot(request.resource.data, communityId);
        allow delete: if isCommunityOwnerOrAdmin(communityId) || isModerator();
      }
    }

    match /communityMemberships/{membershipId} {
      allow read: if signedIn();
      allow create: if owns('userId');
      allow update: if signedIn() && (
        existingOwner('userId') 
        || isModerator()
        || (exists(/databases/$(database)/documents/communities/$(resource.data.communityId)) 
            && (
              get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.ownerId == uid()
              || (
                'adminIds' in get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data
                && uid() in get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.adminIds
              )
            ))
      );
      allow delete: if signedIn() && (
        existingOwner('userId') 
        || isModerator()
        || (exists(/databases/$(database)/documents/communities/$(resource.data.communityId)) 
            && (
              get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.ownerId == uid()
              || (
                'adminIds' in get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data
                && uid() in get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.adminIds
              )
            ))
      );
    }

    function isValidCommunityHealthId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidHealthNumberOrNull(val) {
      return val == null || (val is number && val >= 0);
    }

    function isValidCommunityHealthSnapshot(data, communityId) {
      return data.keys().hasAll([
          'id',
          'communityId',
          'periodKey',
          'generatedBy',
          'generatedAt',
          'activeMembersCount',
          'totalContributions',
          'insightsCount',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'communityId',
          'periodKey',
          'generatedBy',
          'generatedAt',
          'activeMembersCount',
          'activeContributorRate',
          'totalContributions',
          'pollVoterTurnout',
          'newMemberActivationRate',
          'contributionConcentrationIndex',
          'returningContributorRetention',
          'multiPillarParticipationRate',
          'insightsCount',
          'updatedAt'
        ])
        && data.id is string && data.id in ['7d', '30d', '90d']
        && data.periodKey is string && data.periodKey in ['7d', '30d', '90d']
        && data.id == data.periodKey
        && data.communityId is string && data.communityId == communityId && data.communityId.size() <= 128
        && data.generatedBy is string && data.generatedBy == uid() && data.generatedBy.size() <= 128
        && data.generatedAt is string && data.generatedAt.size() <= 64
        && data.activeMembersCount is int && data.activeMembersCount >= 0
        && data.totalContributions is int && data.totalContributions >= 0
        && data.insightsCount is int && data.insightsCount >= 0
        && isValidHealthNumberOrNull(data.get('activeContributorRate', null))
        && isValidHealthNumberOrNull(data.get('pollVoterTurnout', null))
        && isValidHealthNumberOrNull(data.get('newMemberActivationRate', null))
        && isValidHealthNumberOrNull(data.get('contributionConcentrationIndex', null))
        && isValidHealthNumberOrNull(data.get('returningContributorRetention', null))
        && isValidHealthNumberOrNull(data.get('multiPillarParticipationRate', null))
        && data.updatedAt == request.time;
    }

    function isCommunityOwnerOrAdmin(communityId) {
      return signedIn() && exists(/databases/$(database)/documents/communities/$(communityId))
        && (
          get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId == uid()
          || (
            'creatorId' in get(/databases/$(database)/documents/communities/$(communityId)).data
            && get(/databases/$(database)/documents/communities/$(communityId)).data.creatorId == uid()
          )
          || (
            'adminIds' in get(/databases/$(database)/documents/communities/$(communityId)).data
            && uid() in get(/databases/$(database)/documents/communities/$(communityId)).data.adminIds
          )
        );
    }

    function canCreateConclaveInCommunity(communityId) {
      return signedIn() && exists(/databases/$(database)/documents/communities/$(communityId))
        && (
          isCommunityOwnerOrAdmin(communityId)
          || (
            (
              ('conclaveCreationPermission' in get(/databases/$(database)/documents/communities/$(communityId)).data
                && get(/databases/$(database)/documents/communities/$(communityId)).data.conclaveCreationPermission == 'ALL_MEMBERS')
              || ('gatheringPermission' in get(/databases/$(database)/documents/communities/$(communityId)).data
                && get(/databases/$(database)/documents/communities/$(communityId)).data.gatheringPermission == 'all')
            )
            && exists(/databases/$(database)/documents/communityMemberships/$(uid() + '_' + communityId))
            && get(/databases/$(database)/documents/communityMemberships/$(uid() + '_' + communityId)).data.status == 'active'
          )
        );
    }

    match /conclaveGatherings/{gatheringId} {
      allow read: if signedIn();
      allow create: if owns('hostId') || isCommunityOwnerOrAdmin(request.resource.data.communityId);
      allow update: if signedIn() && (
        existingOwner('hostId')
        || isCommunityOwnerOrAdmin(resource.data.communityId)
        || isModerator()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendeeCount', 'attendeeIds', 'updatedAt'])
      );
      allow delete: if existingOwner('hostId') || isCommunityOwnerOrAdmin(resource.data.communityId) || isModerator();
    }

    match /collectiveMemories/{memoryId} {
      // Non-members must not gain access to private community memories
      // Ordinary signed in users can read public memories or if they are active members / owners / admins
      allow read: if signedIn() && (
        (exists(/databases/$(database)/documents/communities/$(resource.data.communityId))
         && get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.visibility == 'public'
         && (!('status' in resource.data) || resource.data.status == 'published'))
        || isCommunityOwnerOrAdmin(resource.data.communityId)
        || (resource.data.creatorUid == uid())
        || (exists(/databases/$(database)/documents/communityMemberships/$(uid() + '_' + resource.data.communityId))
            && get(/databases/$(database)/documents/communityMemberships/$(uid() + '_' + resource.data.communityId)).data.status == 'active')
      );

      // Create: Owner, admin, or creator who is an active member
      allow create: if signedIn() && (
        isCommunityOwnerOrAdmin(request.resource.data.communityId)
        || (
          request.resource.data.creatorUid == uid()
          && exists(/databases/$(database)/documents/communityMemberships/$(uid() + '_' + request.resource.data.communityId))
          && get(/databases/$(database)/documents/communityMemberships/$(uid() + '_' + request.resource.data.communityId)).data.status == 'active'
        )
      );

      // Update / Delete: Community owner, admin, or creator
      // Only Community Owner, Admin, or Moderator can pin/unpin memories (modify 'isFeatured')
      allow update: if signedIn() && (
        isCommunityOwnerOrAdmin(resource.data.communityId)
        || (
          resource.data.creatorUid == uid()
          && request.resource.data.creatorUid == uid()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isFeatured'])
        )
        || isModerator()
      );

      allow delete: if signedIn() && (
        isCommunityOwnerOrAdmin(resource.data.communityId)
        || resource.data.creatorUid == uid()
        || isModerator()
      );
    }

    match /conclaveEvents/{eventId} {
      // Draft events are exclusively accessible to organizers, owners, and admins
      allow read: if signedIn() && (
        !('eventStatus' in resource.data)
        || resource.data.eventStatus != 'DRAFT'
        || resource.data.organizerUid == uid()
        || resource.data.hostId == uid()
        || isCommunityOwnerOrAdmin(resource.data.communityId)
        || isModerator()
      );
      allow create: if signedIn() && (owns('organizerUid') || owns('hostId')) && (
        canCreateConclaveInCommunity(request.resource.data.communityId) || isModerator()
      );
      allow update: if signedIn() && (
        existingOwner('organizerUid')
        || existingOwner('hostId')
        || isCommunityOwnerOrAdmin(resource.data.communityId)
        || isModerator()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredCount', 'attendeeCount', 'attendeeIds', 'updatedAt'])
      );
      allow delete: if signedIn() && (
        // Organizers can delete draft events; published/cancelled events are preserved for history
        (resource.data.eventStatus == 'DRAFT' && (
          existingOwner('organizerUid')
          || existingOwner('hostId')
          || isCommunityOwnerOrAdmin(resource.data.communityId)
        ))
        || isModerator()
      );

      match /protected/{docId} {
        allow read: if signedIn() && (
          isCommunityOwnerOrAdmin(get(/databases/$(database)/documents/conclaveEvents/$(eventId)).data.communityId)
          || get(/databases/$(database)/documents/conclaveEvents/$(eventId)).data.organizerUid == uid()
          || (
            exists(/databases/$(database)/documents/conclaveRegistrations/$(eventId + '_' + uid()))
            && get(/databases/$(database)/documents/conclaveRegistrations/$(eventId + '_' + uid())).data.status == 'CONFIRMED'
          )
          || isModerator()
        );
        allow write: if signedIn() && (
          isCommunityOwnerOrAdmin(get(/databases/$(database)/documents/conclaveEvents/$(eventId)).data.communityId)
          || get(/databases/$(database)/documents/conclaveEvents/$(eventId)).data.organizerUid == uid()
          || isModerator()
        );
      }
    }

    match /conclaveRegistrations/{regId} {
      allow read: if signedIn() && (
        resource.data.userId == uid()
        || isCommunityOwnerOrAdmin(resource.data.communityId)
        || isModerator()
      );
      allow create: if signedIn() && request.resource.data.userId == uid();
      allow update: if signedIn() && (
        resource.data.userId == uid()
        || isCommunityOwnerOrAdmin(resource.data.communityId)
        || isModerator()
      );
      allow delete: if signedIn() && (
        resource.data.userId == uid()
        || isCommunityOwnerOrAdmin(resource.data.communityId)
        || isModerator()
      );
    }

    match /conclaveAttendance/{attendanceId} {
      allow read: if signedIn() && (
        resource.data.userId == uid()
        || isCommunityOwnerOrAdmin(resource.data.communityId)
        || isModerator()
      );
      allow write: if signedIn() && (
        isCommunityOwnerOrAdmin(request.resource.data.communityId)
        || isModerator()
      );
    }

    match /communityPrivateMessages/{messageId} {
      allow read, create: if signedIn();
      allow update, delete: if signedIn() && (resource.data.authorId == uid() || isModerator());
    }

    match /comments/{commentId} {
      function canAccessCommentTarget(postId) {
        return !exists(/databases/$(database)/documents/posts/$(postId))
          || !isHubPostData(get(/databases/$(database)/documents/posts/$(postId)).data)
          || isAcceptedConnection(get(/databases/$(database)/documents/posts/$(postId)).data.authorId)
          || isModerator();
      }

      allow get: if signedIn() && (!('postId' in resource.data) || canAccessCommentTarget(resource.data.postId));
      allow list: if signedIn();
      allow create: if owns('authorId') && (!('postId' in request.resource.data) || canAccessCommentTarget(request.resource.data.postId));
      allow update, delete: if existingOwner('authorId') || isModerator();
    }

    match /likes/{likeId} {
      allow get: if signedIn() && (
        (resource != null && resource.data.userId == uid())
        || (resource == null && likeId.size() > uid().size() && likeId[0:uid().size() + 1] == uid() + '_')
      );
      allow list: if signedIn() && resource.data.userId == uid();
      allow create: if signedIn() && (
        (
          ('targetType' in request.resource.data && request.resource.data.targetType == 'trendz')
          && isValidTrendLikeDoc(request.resource.data, likeId)
          && isPublishedTrend(request.resource.data.targetId)
        )
        || (
          !('targetType' in request.resource.data && request.resource.data.targetType == 'trendz')
          && owns('userId')
        )
      );
      allow delete: if existingOwner('userId') || isModerator();
      allow update: if false;
    }

    match /bookmarks/{bookmarkId} {
      allow get: if signedIn() && (
        (resource != null && resource.data.userId == uid())
        || (resource == null && bookmarkId.size() > uid().size() && bookmarkId[0:uid().size() + 1] == uid() + '_')
      );
      allow list: if signedIn() && resource.data.userId == uid();
      allow create: if signedIn() && (
        (
          ('targetType' in request.resource.data && request.resource.data.targetType == 'trendz')
          && isValidTrendBookmarkDoc(request.resource.data, bookmarkId)
          && isPublishedTrend(request.resource.data.targetId)
        )
        || (
          !('targetType' in request.resource.data && request.resource.data.targetType == 'trendz')
          && owns('userId')
        )
      );
      allow delete: if existingOwner('userId') || isModerator();
      allow update: if false;
    }

    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && (
                      (('followerId' in request.resource.data) && request.resource.data.followerId == uid()) ||
                      (('followerUid' in request.resource.data) && request.resource.data.followerUid == uid())
                    )
                    && (
                      (!('followerId' in request.resource.data) || !('followingId' in request.resource.data) || request.resource.data.followerId != request.resource.data.followingId) &&
                      (!('followerUid' in request.resource.data) || !('followingUid' in request.resource.data) || request.resource.data.followerUid != request.resource.data.followingUid)
                    );
      allow delete: if signedIn() && (
                      (('followerId' in resource.data) && resource.data.followerId == uid()) ||
                      (('followerUid' in resource.data) && resource.data.followerUid == uid()) ||
                      isModerator()
                    );
      allow update: if false;
    }

    match /applications/{applicationId} {
      allow read: if signedIn() && (resource.data.applicantId == uid() || resource.data.ownerId == uid() || (('creatorId' in resource.data) && resource.data.creatorId == uid()) || isModerator());
      allow create: if owns('applicantId');
      allow update: if signedIn() && (resource.data.applicantId == uid() || resource.data.ownerId == uid() || (('creatorId' in resource.data) && resource.data.creatorId == uid()) || isModerator());
      allow delete: if isModerator();
    }

    match /savedOpportunities/{savedId} {
      allow read: if signedIn() && resource.data.userId == uid();
      allow create: if owns('userId');
      allow delete: if existingOwner('userId') || isModerator();
      allow update: if false;
    }

    match /notifications/{notificationId} {
      allow read, delete: if signedIn() && resource.data.recipientId == uid();
      allow update: if signedIn() && resource.data.recipientId == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt', 'updatedAt']);
      allow create: if signedIn()
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId != uid()
        && (!('actorId' in request.resource.data) || request.resource.data.actorId == uid() || request.resource.data.actorId == null)
        && (!('senderId' in request.resource.data) || request.resource.data.senderId == uid() || request.resource.data.senderId == null);
    }

    match /reports/{reportId} {
      allow read, update, delete: if isModerator();
      allow create: if owns('reporterId');
    }

    match /messages/{conversationId} {
      allow read, delete: if signedIn() && (uid() in resource.data.participants || isModerator());
      allow create: if signedIn() && uid() in request.resource.data.participants;
      allow update: if signedIn() && (uid() in resource.data.participants || uid() in request.resource.data.participants || isModerator());

      match /messages/{messageId} {
        allow read: if signedIn()
          && (uid() in get(/databases/$(database)/documents/messages/$(conversationId)).data.participants || isModerator());
        allow create: if signedIn()
          && request.resource.data.senderId == uid()
          && uid() in get(/databases/$(database)/documents/messages/$(conversationId)).data.participants;
        allow update: if signedIn() && (
          (resource.data.senderId == uid() || isModerator())
          || (
            (resource.data.recipientId == uid() || uid() in get(/databases/$(database)/documents/messages/$(conversationId)).data.participants)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt', 'readBy'])
          )
        );
        allow delete: if signedIn()
          && (resource.data.senderId == uid() || isModerator());
      }
    }

    match /hubConversations/{conversationId} {
      function isComrade() {
        return resource.data.category == 'comrade';
      }
      function isGroup() {
        return resource.data.category == 'group' || ('isGroup' in resource.data && resource.data.isGroup == true);
      }
      function otherComradeId(participants) {
        return participants[0] == uid() ? participants[1] : participants[0];
      }

      allow read: if signedIn() && (
        (isComrade() && uid() in resource.data.participantIds && isAcceptedConnection(otherComradeId(resource.data.participantIds)))
        || (isGroup() && uid() in resource.data.memberIds)
        || isModerator()
      );

      allow create: if signedIn() && (
        (request.resource.data.category == 'comrade'
         && uid() in request.resource.data.participantIds
         && isAcceptedConnection(otherComradeId(request.resource.data.participantIds)))
        || (request.resource.data.category == 'group' && uid() in request.resource.data.memberIds)
        || isModerator()
      );

      allow update: if signedIn() && (
        (isComrade() && uid() in resource.data.participantIds && isAcceptedConnection(otherComradeId(resource.data.participantIds)))
        || (isGroup() && uid() in resource.data.memberIds)
        || isModerator()
      );

      allow delete: if signedIn() && (
        (isComrade() && uid() in resource.data.participantIds)
        || (isGroup() && resource.data.ownerId == uid())
        || isModerator()
      );

      match /messages/{messageId} {
        function parentHubConvo() {
          return get(/databases/$(database)/documents/hubConversations/$(conversationId)).data;
        }

        function otherParentComrade() {
          return parentHubConvo().participantIds[0] == uid() ? parentHubConvo().participantIds[1] : parentHubConvo().participantIds[0];
        }

        allow read: if signedIn() && (
          (parentHubConvo().category == 'comrade'
           && uid() in parentHubConvo().participantIds
           && isAcceptedConnection(otherParentComrade()))
          || (parentHubConvo().category == 'group' && uid() in parentHubConvo().memberIds)
          || isModerator()
        );

        allow create: if signedIn()
          && request.resource.data.senderId == uid()
          && (
            (parentHubConvo().category == 'comrade'
             && uid() in parentHubConvo().participantIds
             && isAcceptedConnection(otherParentComrade()))
            || (parentHubConvo().category == 'group' && uid() in parentHubConvo().memberIds)
            || isModerator()
          );

        allow update, delete: if signedIn() && (
          resource.data.senderId == uid() || isModerator()
        );
      }
    }

    match /platformConfig/{configId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /teams/{teamId} {
      allow get: if true;
      allow list: if signedIn() && (
        ('memberIds' in resource.data && uid() in resource.data.memberIds)
        || resource.data.ownerId == uid()
        || isModerator()
      );
      allow create: if signedIn() && request.resource.data.ownerId == uid() && uid() in request.resource.data.memberIds;
      allow update: if signedIn() && (
        (resource.data.ownerId == uid() && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId'])
          || (request.resource.data.ownerId is string && request.resource.data.ownerId in resource.data.memberIds)
        ))
        || (('memberIds' in resource.data && uid() in resource.data.memberIds)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageSenderId', 'lastMessageSenderName', 'lastMessageTimestamp', 'updatedAt']))
        || (('memberIds' in resource.data && uid() in resource.data.memberIds)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'memberCount', 'updatedAt']))
        || (!('memberIds' in resource.data) || !(uid() in resource.data.memberIds))
        || isModerator()
      );
      allow delete: if signedIn() && (resource.data.ownerId == uid() || isModerator());

      match /members/{memberId} {
        allow read: if signedIn() && (
          uid() in get(/databases/$(database)/documents/teams/$(teamId)).data.memberIds
          || get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId == uid()
          || isModerator()
        );
        allow create: if signedIn() && (
          memberId == uid()
          || get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId == uid()
          || isModerator()
        );
        allow update: if signedIn() && (
          get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId == uid()
          || (memberId == uid() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReadAt']))
          || isModerator()
        );
        allow delete: if signedIn() && (
          memberId == uid()
          || get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId == uid()
          || isModerator()
        );
      }

      match /messages/{messageId} {
        allow read: if signedIn() && (
          uid() in get(/databases/$(database)/documents/teams/$(teamId)).data.memberIds
          || isModerator()
        );
        allow create: if signedIn()
          && request.resource.data.senderId == uid()
          && uid() in get(/databases/$(database)/documents/teams/$(teamId)).data.memberIds;
        allow update: if signedIn() && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
          || (resource.data.senderId == uid()
              && request.resource.data.senderId == uid()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt']))
          || isModerator()
        );
        allow delete: if signedIn() && (
          resource.data.senderId == uid()
          || get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId == uid()
          || isModerator()
        );
      }

      match /joinRequests/{requestId} {
        allow read: if signedIn() && (
          requestId == uid()
          || resource.data.userId == uid()
          || get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId == uid()
          || isModerator()
        );
        allow create: if signedIn()
          && (requestId == uid() || request.resource.data.userId == uid())
          && request.resource.data.teamId == teamId
          && request.resource.data.status == 'PENDING';
        allow update: if signedIn() && (
          get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId == uid()
          || isModerator()
          || (resource.data.userId == uid()
              && request.resource.data.status == 'CANCELLED'
              && resource.data.status == 'PENDING'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
        );
        allow delete: if signedIn() && (
          resource.data.userId == uid()
          || get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId == uid()
          || isModerator()
        );
      }
    }

    match /teamInvitations/{token} {
      allow get: if true;
      allow list: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == uid();
      allow update: if signedIn() && (
        resource.data.createdBy == uid()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount', 'usedBy', 'updatedAt'])
        || isModerator()
      );
      allow delete: if signedIn() && (resource.data.createdBy == uid() || isModerator());
    }
  }
}
