rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isSupportedMedia() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType.matches('video/.*')
        || request.resource.contentType == 'application/pdf';
    }

    function underSize(maxBytes) {
      return request.resource.size <= maxBytes;
    }

    function hasAcceptedConnectionWith(ownerId) {
      return signedIn() && (
        ownerId == request.auth.uid ||
        (firestore.exists(/databases/(default)/documents/follows/$(request.auth.uid)_$(ownerId)) &&
         firestore.exists(/databases/(default)/documents/follows/$(ownerId)_$(request.auth.uid)))
      );
    }

    // ── Hub Media (Moments: Stills, Tapes, Knacks) ────────────────────────
    match /hubMedia/{userId}/{fileName} {
      allow read: if signedIn() && hasAcceptedConnectionWith(userId);
      allow create, update: if signedIn()
        && userId == request.auth.uid
        && isSupportedMedia()
        && underSize(100 * 1024 * 1024);
      allow delete: if signedIn() && userId == request.auth.uid;
    }

    // ── Loops Media (Zaps, Thoughts, Music, Mood) ─────────────────────────
    match /loops/{userId}/{fileName} {
      allow read: if signedIn() && hasAcceptedConnectionWith(userId);
      allow create, update: if signedIn()
        && userId == request.auth.uid
        && isSupportedMedia()
        && underSize(100 * 1024 * 1024);
      allow delete: if signedIn() && userId == request.auth.uid;
    }

    // ── Profile Media (avatars + cover photos) ────────────────────────────
    // Path: /profileMedia/{userId}/{fileName}
    // The userId path segment IS the auth check — no custom metadata required.
    // Supports files up to 10 MB.
    match /profileMedia/{userId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && userId == request.auth.uid
        && isImage()
        && underSize(10 * 1024 * 1024);
      allow delete: if signedIn() && userId == request.auth.uid;
    }

    // ── Post Media ────────────────────────────────────────────────────────
    match /postMedia/{userId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && userId == request.auth.uid
        && isSupportedMedia()
        && underSize(100 * 1024 * 1024);
      allow delete: if signedIn() && userId == request.auth.uid;
    }

    // ── Project Assets ────────────────────────────────────────────────────
    match /projectAssets/{projectId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && isSupportedMedia()
        && underSize(100 * 1024 * 1024);
      allow delete: if signedIn();
    }

    // ── Community Assets ──────────────────────────────────────────────────
    match /communityAssets/{communityId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && isSupportedMedia()
        && underSize(50 * 1024 * 1024);
      allow delete: if signedIn();
    }

    // ── Message Files ─────────────────────────────────────────────────────
    match /messageFiles/{conversationId}/{messageId}/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn()
        && isSupportedMedia()
        && underSize(100 * 1024 * 1024);
      allow update: if false;
      allow delete: if signedIn();
    }

    // ── Application Documents (PDF CVs, etc.) ─────────────────────────────
    match /applications/{userId}/{fileName} {
      allow read: if signedIn() && userId == request.auth.uid;
      allow create, update: if signedIn()
        && userId == request.auth.uid
        && request.resource.contentType == 'application/pdf'
        && underSize(15 * 1024 * 1024);
      allow delete: if signedIn() && userId == request.auth.uid;
    }

    function isTrendzModerator() {
      return signedIn() && (
        (request.auth.token.email_verified == true
          && request.auth.token.email in ['akshaayvardhans@gmail.com'])
        || (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'])
      );
    }

    // ── Trendz Media (verified thumbnails & AI-generated editorial visuals) ──
    // Signed-in users may read; only verified admins/moderators (or backend Admin SDK) may upload images <= 10 MB.
    match /trendzMedia/{trendId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if isTrendzModerator()
        && isImage()
        && underSize(10 * 1024 * 1024);
      allow delete: if isTrendzModerator();
    }

    // ── Catch-all: deny everything else ──────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
