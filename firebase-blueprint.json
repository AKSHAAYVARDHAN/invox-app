{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role, metrics, and metadata.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "User email" },
        "name": { "type": "string", "description": "Display name" },
        "avatarUrl": { "type": "string", "description": "Profile picture URL" },
        "role": { "type": "string", "enum": ["user", "moderator", "admin"] },
        "followerCount": { "type": "number" },
        "followingCount": { "type": "number" },
        "savedPostCount": { "type": "number" },
        "savedProjectCount": { "type": "number" },
        "savedOpportunityCount": { "type": "number" },
        "reputation": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Channel": {
      "title": "Channel",
      "description": "User-owned channel for publishing feeds and organizing content broadcasts.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "description": "Channel name" },
        "description": { "type": "string", "description": "Channel description" },
        "handle": { "type": "string", "description": "Channel unique handle" },
        "domain": { "type": "string", "description": "Channel domain/category" },
        "category": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "bannerUrl": { "type": "string" },
        "ownerId": { "type": "string", "description": "Owner UID" },
        "authorName": { "type": "string" },
        "authorAvatarUrl": { "type": "string" },
        "subscriberCount": { "type": "number" },
        "postCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "ownerId", "createdAt"]
    },
    "Post": {
      "title": "Post",
      "description": "Feed, Query, or Thread item with multimedia content and AI summary.",
      "type": "object",
      "properties": {
        "channelId": { "type": "string", "description": "Channel ID for Feed posts" },
        "channelName": { "type": "string", "description": "Channel name" },
        "channelAvatarUrl": { "type": "string", "description": "Channel avatar URL" },
        "authorId": { "type": "string", "description": "Author UID" },
        "author": { "type": "object", "description": "Author metadata" },
        "content": { "type": "string", "description": "Post text content" },
        "aiSummary": { "type": "string", "description": "AI-generated summary" },
        "category": { "type": "string", "description": "Post category" },
        "domain": { "type": "string", "description": "Associated domain" },
        "type": { "type": "string", "enum": ["Feed", "Thread", "Query"] },
        "mediaUrl": { "type": "string", "description": "Uploaded media URL" },
        "mediaType": { "type": "string", "enum": ["image", "video"] },
        "thumbnailUrl": { "type": "string" },
        "stats": { "type": "object", "description": "Likes, views, comments counts" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "content", "createdAt"]
    },
    "Project": {
      "title": "Project",
      "description": "Collaborative project listing in the workspace.",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "published", "archived"] },
        "category": { "type": "string" },
        "tags": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "title", "status", "createdAt"]
    },
    "PlatformSections": {
      "title": "PlatformSections",
      "description": "Centralized platform section availability, status, and visibility configuration.",
      "type": "object",
      "properties": {
        "sections": {
          "type": "object",
          "description": "Map of platform sections and their runtime configuration"
        },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": ["sections"]
    },
    "Team": {
      "title": "Team",
      "description": "Project team spaces for multi-user collaboration and group chat.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "description": "Team name" },
        "description": { "type": "string", "description": "Team description" },
        "projectId": { "type": "string", "description": "Associated project ID" },
        "projectTitle": { "type": "string", "description": "Associated project title" },
        "ownerId": { "type": "string", "description": "Team owner UID" },
        "ownerName": { "type": "string", "description": "Team owner name" },
        "ownerAvatar": { "type": "string" },
        "memberCount": { "type": "number", "description": "Count of members" },
        "memberIds": { "type": "array", "description": "List of user UIDs" },
        "lastMessage": { "type": "string" },
        "lastMessageSenderId": { "type": "string" },
        "lastMessageSenderName": { "type": "string" },
        "lastMessageTimestamp": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "projectId", "ownerId", "memberIds", "createdAt"]
    },
    "TeamMember": {
      "title": "TeamMember",
      "description": "Members belonging to a project team.",
      "type": "object",
      "properties": {
        "teamId": { "type": "string" },
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "username": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "member"] },
        "projectRole": { "type": "string" },
        "joinedAt": { "type": "string", "format": "date-time" },
        "lastReadAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teamId", "userId", "role", "joinedAt"]
    },
    "TeamMessage": {
      "title": "TeamMessage",
      "description": "Group chat messages sent within a team.",
      "type": "object",
      "properties": {
        "teamId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderAvatar": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "readBy": { "type": "array" }
      },
      "required": ["teamId", "senderId", "text", "createdAt"]
    },
    "TeamInvitation": {
      "title": "TeamInvitation",
      "description": "Secure invitation tokens for joining project teams.",
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "teamId": { "type": "string" },
        "teamName": { "type": "string" },
        "projectId": { "type": "string" },
        "projectTitle": { "type": "string" },
        "ownerId": { "type": "string" },
        "ownerName": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["active", "revoked"] },
        "maxUses": { "type": "number" },
        "usedCount": { "type": "number" },
        "usedBy": { "type": "array" }
      },
      "required": ["token", "teamId", "createdBy", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User documents containing profile and system roles."
    },
    "/channels/{channelId}": {
      "schema": "Channel",
      "description": "User channels for hosting published feeds."
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Public and user posts including feeds, queries, and threads."
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Collaborative projects and venture briefs."
    },
    "/platformConfig/{configId}": {
      "schema": "PlatformSections",
      "description": "Platform configuration documents including module sections management."
    },
    "/teams/{teamId}": {
      "schema": "Team",
      "description": "Project team spaces for multi-user collaboration and group chat."
    },
    "/teams/{teamId}/members/{memberId}": {
      "schema": "TeamMember",
      "description": "Members belonging to a project team."
    },
    "/teams/{teamId}/messages/{messageId}": {
      "schema": "TeamMessage",
      "description": "Group chat messages sent within a team."
    },
    "/teamInvitations/{token}": {
      "schema": "TeamInvitation",
      "description": "Secure invitation tokens for joining project teams."
    }
  }
}
