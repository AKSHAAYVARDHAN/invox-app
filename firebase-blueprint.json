{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role, metrics, and metadata.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "User email" },
        "name": { "type": "string", "description": "Display name" },
        "avatarUrl": { "type": "string", "description": "Profile picture URL" },
        "role": { "type": "string", "enum": ["user", "moderator", "admin"] },
        "followerCount": { "type": "number" },
        "followingCount": { "type": "number" },
        "savedPostCount": { "type": "number" },
        "savedProjectCount": { "type": "number" },
        "savedOpportunityCount": { "type": "number" },
        "reputation": { "type": "number" },
        "followedTrendDomains": { "type": "array", "description": "Canonical Trendz domain slugs followed by the user" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Channel": {
      "title": "Channel",
      "description": "User-owned channel for publishing feeds and organizing content broadcasts.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "description": "Channel name" },
        "description": { "type": "string", "description": "Channel description" },
        "handle": { "type": "string", "description": "Channel unique handle" },
        "domain": { "type": "string", "description": "Channel domain/category" },
        "category": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "bannerUrl": { "type": "string" },
        "ownerId": { "type": "string", "description": "Owner UID" },
        "authorName": { "type": "string" },
        "authorAvatarUrl": { "type": "string" },
        "subscriberCount": { "type": "number" },
        "postCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "ownerId", "createdAt"]
    },
    "Post": {
      "title": "Post",
      "description": "Feed, Query, or Thread item with multimedia content and AI summary.",
      "type": "object",
      "properties": {
        "channelId": { "type": "string", "description": "Channel ID for Feed posts" },
        "channelName": { "type": "string", "description": "Channel name" },
        "channelAvatarUrl": { "type": "string", "description": "Channel avatar URL" },
        "communityId": { "type": "string", "description": "Community collective ID if posted to a community" },
        "communityName": { "type": "string", "description": "Community collective name" },
        "communityAvatarUrl": { "type": "string", "description": "Community avatar URL" },
        "communityHandle": { "type": "string", "description": "Community handle" },
        "visibility": { "type": "string", "enum": ["public", "private", "unlisted"], "description": "Post visibility level" },
        "authorId": { "type": "string", "description": "Author UID" },
        "author": { "type": "object", "description": "Author metadata" },
        "content": { "type": "string", "description": "Post text content" },
        "aiSummary": { "type": "string", "description": "AI-generated summary" },
        "category": { "type": "string", "description": "Post category" },
        "domain": { "type": "string", "description": "Associated domain" },
        "type": { "type": "string", "enum": ["Feed", "Thread", "Query", "Collab", "Showcase", "Moment"] },
        "momentType": { "type": "string", "enum": ["Stills", "Tapes", "Knacks"], "description": "Category for Moments: Stills, Tapes, or Knacks" },
        "mediaUrl": { "type": "string", "description": "Uploaded media URL" },
        "mediaUrls": { "type": "array", "description": "List of attached media URLs" },
        "mediaType": { "type": "string", "enum": ["image", "video"] },
        "thumbnailUrl": { "type": "string" },
        "stats": { "type": "object", "description": "Likes, views, comments counts" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "content", "createdAt"]
    },
    "Project": {
      "title": "Project",
      "description": "Collaborative project listing in the workspace.",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "published", "archived"] },
        "category": { "type": "string" },
        "tags": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "title", "status", "createdAt"]
    },
    "PlatformSections": {
      "title": "PlatformSections",
      "description": "Centralized platform section availability, status, and visibility configuration.",
      "type": "object",
      "properties": {
        "sections": {
          "type": "object",
          "description": "Map of platform sections and their runtime configuration"
        },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": ["sections"]
    },
    "Team": {
      "title": "Team",
      "description": "Project team spaces for multi-user collaboration and group chat.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "description": "Team name" },
        "description": { "type": "string", "description": "Team description" },
        "projectId": { "type": "string", "description": "Associated project ID" },
        "projectTitle": { "type": "string", "description": "Associated project title" },
        "ownerId": { "type": "string", "description": "Team owner UID" },
        "ownerName": { "type": "string", "description": "Team owner name" },
        "ownerAvatar": { "type": "string" },
        "avatarUrl": { "type": "string", "description": "Crew squad avatar image URL" },
        "joinPolicy": { "type": "string", "enum": ["open", "approval_required"], "description": "Team join policy" },
        "memberCount": { "type": "number", "description": "Count of members" },
        "memberIds": { "type": "array", "description": "List of user UIDs" },
        "lastMessage": { "type": "string" },
        "lastMessageSenderId": { "type": "string" },
        "lastMessageSenderName": { "type": "string" },
        "lastMessageTimestamp": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "projectId", "ownerId", "memberIds", "createdAt"]
    },
    "TeamMember": {
      "title": "TeamMember",
      "description": "Members belonging to a project team.",
      "type": "object",
      "properties": {
        "teamId": { "type": "string" },
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "username": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "member"] },
        "projectRole": { "type": "string" },
        "joinedAt": { "type": "string", "format": "date-time" },
        "lastReadAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teamId", "userId", "role", "joinedAt"]
    },
    "TeamMessage": {
      "title": "TeamMessage",
      "description": "Group chat messages sent within a team.",
      "type": "object",
      "properties": {
        "teamId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderAvatar": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "editedAt": { "type": "string", "format": "date-time", "description": "Timestamp when message was last edited by author" },
        "readBy": { "type": "array" }
      },
      "required": ["teamId", "senderId", "text", "createdAt"]
    },
    "TeamJoinRequest": {
      "title": "TeamJoinRequest",
      "description": "Membership requests submitted by users for approval-required teams.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teamId": { "type": "string" },
        "teamName": { "type": "string" },
        "projectId": { "type": "string" },
        "projectTitle": { "type": "string" },
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "username": { "type": "string" },
        "photoURL": { "type": "string" },
        "email": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED", "CANCELLED"] },
        "invitationToken": { "type": "string" },
        "requestMessage": { "type": "string" },
        "reviewedBy": { "type": "string" },
        "reviewedByName": { "type": "string" },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "rejectionReason": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teamId", "userId", "displayName", "status", "createdAt"]
    },
    "TeamInvitation": {
      "title": "TeamInvitation",
      "description": "Secure invitation tokens for joining project teams.",
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "teamId": { "type": "string" },
        "teamName": { "type": "string" },
        "projectId": { "type": "string" },
        "projectTitle": { "type": "string" },
        "ownerId": { "type": "string" },
        "ownerName": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["active", "revoked"] },
        "maxUses": { "type": "number" },
        "usedCount": { "type": "number" },
        "usedBy": { "type": "array" }
      },
      "required": ["token", "teamId", "createdBy", "status", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System and user event notifications for messages, teams, collabs, and connections.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recipientId": { "type": "string", "description": "Target recipient user UID" },
        "actorId": { "type": "string", "description": "Actor user UID who triggered the event" },
        "actorName": { "type": "string" },
        "actorAvatar": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "read": { "type": "boolean" },
        "readAt": { "type": "string", "format": "date-time" },
        "targetType": { "type": "string" },
        "targetId": { "type": "string" },
        "metadata": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recipientId", "type", "title", "read", "createdAt"]
    },
    "UsernameMapping": {
      "title": "UsernameMapping",
      "description": "Globally unique normalized username to user UID canonical lookup mapping.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Canonical Firebase Auth UID of the username owner" },
        "username": { "type": "string", "description": "Normalized unique username" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "description": "User saved project, post, or trend bookmark reference.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "User UID who bookmarked the target" },
        "postId": { "type": "string", "description": "Target post or project ID (legacy/post bookmarks)" },
        "targetType": { "type": "string", "enum": ["post", "project", "poll", "trendz"], "description": "Target collection type" },
        "targetId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$", "description": "Target document ID" },
        "domainSlug": {
          "type": "string",
          "enum": ["technology", "health-care", "trading", "stock-market", "design", "finance", "science", "gaming", "art", "automotive", "space"],
          "description": "Canonical Trendz domain slug for saved trend records"
        },
        "trendTitle": { "type": "string", "maxLength": 240, "description": "Saved trend title snapshot for graceful deleted/unpublished handling" },
        "trendSummary": { "type": "string", "maxLength": 500, "description": "Saved trend summary snapshot" },
        "trendPublisher": { "type": "string", "maxLength": 160, "description": "Saved trend publisher snapshot" },
        "trendPublishedOn": { "type": "string", "maxLength": 32, "description": "Saved trend publication date snapshot" },
        "trendMediaUrl": { "type": "string", "maxLength": 2048, "description": "Sanitized media URL snapshot" },
        "trendMediaType": { "type": "string", "enum": ["image", "video"], "description": "Saved trend media type snapshot" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId"]
    },
    "Follow": {
      "title": "Follow",
      "description": "User follow and creator tracking relationship.",
      "type": "object",
      "properties": {
        "followerId": { "type": "string", "description": "User UID of follower" },
        "followingId": { "type": "string", "description": "User UID of followed creator" },
        "followerUid": { "type": "string", "description": "Canonical follower UID" },
        "followingUid": { "type": "string", "description": "Canonical following UID" },
        "fromUserId": { "type": "string", "description": "Legacy follower identifier" },
        "toUserId": { "type": "string", "description": "Legacy target identifier" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["followerId", "followingId", "followerUid", "followingUid"]
    },
    "HubConversation": {
      "title": "HubConversation",
      "description": "Hub communication channel. For Comrades (one-to-one), access is restricted to accepted mutual connections. For Crew (groups), access is restricted to explicit group members.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "category": { "type": "string", "enum": ["comrade", "group", "explore", "spotlight"] },
        "isGroup": { "type": "boolean" },
        "participantIds": { "type": "array", "description": "User UIDs participating in Comrade conversation" },
        "memberIds": { "type": "array", "description": "Explicit member UIDs for Crew group" },
        "ownerId": { "type": "string" },
        "lastMessage": { "type": "string" },
        "lastSenderId": { "type": "string" },
        "unreadCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "category", "createdAt"]
    },
    "HubMessage": {
      "title": "HubMessage",
      "description": "Messages sent within a Hub Conversation.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "conversationId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderAvatar": { "type": "string" },
        "text": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "image", "file", "voice"] },
        "mediaUrl": { "type": "string" },
        "fileInfo": { "type": "object" },
        "voiceDuration": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["conversationId", "senderId", "type", "createdAt"]
    },
    "CommunityMembership": {
      "title": "CommunityMembership",
      "description": "User membership record in a technical community.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string", "description": "Firebase Auth UID" },
        "communityId": { "type": "string", "description": "Community identifier" },
        "communityName": { "type": "string" },
        "communityAvatarUrl": { "type": "string" },
        "communityCategory": { "type": "string" },
        "status": { "type": "string", "enum": ["active"] },
        "joinedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "communityId", "status", "joinedAt"]
    },
    "Community": {
      "title": "Community",
      "description": "Domain collective defining Collective Identity (Purpose, Mission, Core Values, Founding Story, Guidelines).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "description": "Community collective name" },
        "description": { "type": "string", "description": "Clear introduction to the collective" },
        "purpose": { "type": "string", "description": "Why the community exists" },
        "mission": { "type": "string", "description": "What the community aims to achieve" },
        "foundingStory": { "type": "string", "description": "Authentic origins and genesis narrative" },
        "values": { "type": "array", "description": "Core guiding values and principles" },
        "guidelines": { "type": "array", "description": "Membership standards and conduct guidelines" },
        "category": { "type": "string" },
        "ownerId": { "type": "string" },
        "adminIds": { "type": "array", "description": "Authorized administrator user UIDs" },
        "avatarUrl": { "type": "string" },
        "bannerUrl": { "type": "string" },
        "members": { "type": "number" },
        "rating": { "type": "number" },
        "isVerified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "description"]
    },
    "CommunityHealthSnapshot": {
      "title": "CommunityHealthSnapshot",
      "description": "Anonymized aggregate Community Health snapshot strictly restricted to community owners and authorized administrators.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "enum": ["7d", "30d", "90d"] },
        "communityId": { "type": "string" },
        "periodKey": { "type": "string", "enum": ["7d", "30d", "90d"] },
        "generatedBy": { "type": "string" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "activeMembersCount": { "type": "number" },
        "activeContributorRate": { "type": "number" },
        "totalContributions": { "type": "number" },
        "pollVoterTurnout": { "type": "number" },
        "newMemberActivationRate": { "type": "number" },
        "contributionConcentrationIndex": { "type": "number" },
        "returningContributorRetention": { "type": "number" },
        "multiPillarParticipationRate": { "type": "number" },
        "insightsCount": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "communityId", "periodKey", "generatedBy", "generatedAt", "activeMembersCount", "totalContributions", "insightsCount", "updatedAt"]
    },
    "TrendRecord": {
      "title": "TrendRecord",
      "description": "Serializable, source-grounded industry trend record stored in /trendz/{trendId}.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "slug": { "type": "string", "maxLength": 160, "pattern": "^[a-z0-9\\-]+$" },
        "status": { "type": "string", "enum": ["draft", "published", "archived", "flagged"] },
        "domainSlug": {
          "type": "string",
          "enum": ["technology", "health-care", "trading", "stock-market", "design", "finance", "science", "gaming", "art", "automotive", "space"]
        },
        "domain": { "type": "string", "maxLength": 80 },
        "category": { "type": "string", "maxLength": 80 },
        "tags": { "type": "array", "description": "Up to 10 normalized topic tags" },
        "searchKeywords": { "type": "array", "description": "Up to 40 lowercased search tokens" },
        "title": { "type": "string", "minLength": 3, "maxLength": 240 },
        "summary": { "type": "string", "minLength": 10, "maxLength": 1200 },
        "fullContent": { "type": "string", "minLength": 10, "maxLength": 20000 },
        "keyTakeaways": { "type": "array", "description": "Up to 10 verified bullet takeaways" },
        "source": { "type": "object", "description": "Verified publisher attribution (name, domain, url, urlHash, author, credibilityTier)" },
        "additionalSources": { "type": "array", "description": "Up to 10 merged corroborating sources" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "discoveredAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "media": { "type": "object", "description": "Serializable media metadata (type, url, thumbnailUrl, overlayUrl, origin, attribution, storagePath)" },
        "momentumScore": { "type": "number" },
        "relatedTrendIds": { "type": "array", "description": "Up to 10 related trend IDs" },
        "stats": { "type": "object", "description": "Server-maintained engagement counters (likes, views, comments, saves, shares)" },
        "schemaVersion": { "type": "number" },
        "aiModel": { "type": "string", "maxLength": 100 },
        "contentHash": { "type": "string", "maxLength": 128 },
        "language": { "type": "string", "maxLength": 16 },
        "region": { "type": "string", "maxLength": 64 },
        "whyItMatters": { "type": "string", "maxLength": 1200 },
        "sourceRetrievedAt": { "type": "string", "format": "date-time" },
        "ingestionRunId": { "type": "string", "maxLength": 128 },
        "ingestionItemId": { "type": "string", "maxLength": 128 },
        "reviewedBy": { "type": "string", "maxLength": 128 },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "groundingStatus": { "type": "string", "enum": ["verified", "needs_review"] }
      },
      "required": [
        "id",
        "slug",
        "status",
        "domainSlug",
        "domain",
        "category",
        "tags",
        "searchKeywords",
        "title",
        "summary",
        "fullContent",
        "keyTakeaways",
        "source",
        "publishedAt",
        "discoveredAt",
        "createdAt",
        "updatedAt",
        "media",
        "momentumScore",
        "relatedTrendIds",
        "stats",
        "schemaVersion"
      ]
    },
    "Like": {
      "title": "Like",
      "description": "User upvote/like reaction record supporting posts, polls, and trendz.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "postId": { "type": "string" },
        "targetType": { "type": "string", "enum": ["post", "poll", "trendz"] },
        "targetId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "domainSlug": {
          "type": "string",
          "enum": ["technology", "health-care", "trading", "stock-market", "design", "finance", "science", "gaming", "art", "automotive", "space"]
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "createdAt"]
    },
    "TrendView": {
      "title": "TrendView",
      "description": "Private per-user deduplicated Trendz view record stored under /users/{userId}/trendViews/{trendId}.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID" },
        "trendId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$", "description": "Published trend document ID" },
        "domainSlug": {
          "type": "string",
          "enum": ["technology", "health-care", "trading", "stock-market", "design", "finance", "science", "gaming", "art", "automotive", "space"]
        },
        "viewedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "trendId", "domainSlug", "viewedAt"]
    },
    "TrendzDomainPreferences": {
      "title": "TrendzDomainPreferences",
      "description": "Private per-user followed Trendz domain preferences stored under /users/{userId}/trendzPreferences/domains (strictly owner-only read and write).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Owner Firebase Auth UID" },
        "followedDomainSlugs": {
          "type": "array",
          "description": "Deduplicated list of canonical Trendz domain slugs followed by the user"
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "followedDomainSlugs", "updatedAt"]
    },
    "Comment": {
      "title": "Comment",
      "description": "User comment or insight attached to posts or trendz.",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "targetType": { "type": "string" },
        "targetId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "text": { "type": "string", "maxLength": 4000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "text", "createdAt"]
    },
    "Report": {
      "title": "Report",
      "description": "User moderation report flagging inaccurate or policy-violating content including trends.",
      "type": "object",
      "properties": {
        "reporterId": { "type": "string" },
        "targetType": { "type": "string" },
        "targetId": { "type": "string" },
        "reason": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reporterId", "targetType", "targetId", "reason", "createdAt"]
    },
    "SparkConversation": {
      "title": "SparkConversation",
      "description": "Per-user contextual Spark AI conversation persisted under /users/{userId}/sparkConversations/{conversationId}.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "contextType": { "type": "string", "enum": ["general", "trendz", "post", "project"] },
        "contextId": { "type": "string", "maxLength": 128 },
        "isPinned": { "type": "boolean" },
        "messages": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "messages", "updatedAt"]
    },
    "TrendSource": {
      "title": "TrendSource",
      "description": "Registry of verified Trendz discovery providers and feed metadata (admin/moderator access only).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 160 },
        "type": { "type": "string", "enum": ["rss", "api"] },
        "enabled": { "type": "boolean" },
        "supportedDomains": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "type"]
    },
    "TrendIngestionRun": {
      "title": "TrendIngestionRun",
      "description": "Traceable Trendz AI intelligence pipeline execution log (admin/moderator access only).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["running", "completed", "partial_failure", "failed"] },
        "triggeredBy": { "type": "string", "maxLength": 128 },
        "triggerMode": { "type": "string", "enum": ["manual", "single_url", "scheduled"] },
        "domains": { "type": "array" },
        "windowHours": { "type": "number" },
        "maxItemsPerDomain": { "type": "number" },
        "providerIds": { "type": "array" },
        "counts": { "type": "object" },
        "errors": { "type": "array" },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "status", "triggeredBy", "triggerMode", "domains", "windowHours", "maxItemsPerDomain", "providerIds", "counts", "errors", "startedAt"]
    },
    "TrendIngestionItem": {
      "title": "TrendIngestionItem",
      "description": "Staged Trendz discovery & AI-processed editorial review item progressing through DISCOVERED -> PUBLISHED/REJECTED/FAILED (admin/moderator access only).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "runId": { "type": "string", "maxLength": 128 },
        "stage": {
          "type": "string",
          "enum": ["DISCOVERED", "VALIDATING", "VALIDATED", "PROCESSING", "PENDING_REVIEW", "APPROVED", "PUBLISHED", "REJECTED", "FAILED"]
        },
        "stageHistory": { "type": "array" },
        "domainSlug": {
          "type": "string",
          "enum": ["technology", "health-care", "trading", "stock-market", "design", "finance", "science", "gaming", "art", "automotive", "space"]
        },
        "providerId": { "type": "string", "maxLength": 80 },
        "providerName": { "type": "string", "maxLength": 120 },
        "source": { "type": "object" },
        "corroboratingSources": { "type": "array" },
        "aiDraft": { "type": "object" },
        "media": { "type": "object" },
        "retryCount": { "type": "number" },
        "failureStage": { "type": "string" },
        "failureReason": { "type": "string" },
        "publishedTrendId": { "type": "string" },
        "reviewedBy": { "type": "string" },
        "rejectionReason": { "type": "string" },
        "createdAtIso": { "type": "string", "format": "date-time" },
        "updatedAtIso": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "runId", "stage", "stageHistory", "domainSlug", "providerId", "providerName", "source", "corroboratingSources", "media", "retryCount", "createdAtIso", "updatedAtIso"]
    }
  },
  "firestore": {
    "/usernames/{username}": {
      "schema": "UsernameMapping",
      "description": "Unique username registry and reverse lookup table."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User documents containing profile and system roles."
    },
    "/channels/{channelId}": {
      "schema": "Channel",
      "description": "User channels for hosting published feeds."
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Public and user posts including feeds, queries, and threads."
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Collaborative projects and venture briefs."
    },
    "/platformConfig/{configId}": {
      "schema": "PlatformSections",
      "description": "Platform configuration documents including module sections management."
    },
    "/teams/{teamId}": {
      "schema": "Team",
      "description": "Project team spaces for multi-user collaboration and group chat."
    },
