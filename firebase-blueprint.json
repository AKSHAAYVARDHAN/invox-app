      "schema": "HubMessage",
      "description": "Messages sent within Hub conversations."
    },
    "/trendz/{trendId}": {
      "schema": "TrendRecord",
      "description": "Source-grounded industry trend records readable by signed-in users when published. Editorial writes are moderator/backend-only; signed-in users may only perform atomic +1/-1 stats updates paired with deterministic engagement records."
    },
    "/users/{userId}/sparkConversations/{conversationId}": {
      "schema": "SparkConversation",
      "description": "Private per-user Spark AI contextual chat sessions."
    },
    "/users/{userId}/trendViews/{trendId}": {
      "schema": "TrendView",
      "description": "Private per-user deduplicated Trendz view records used for view counting and personalization."
    },
    "/users/{userId}/trendzPreferences/{prefId}": {
      "schema": "TrendzDomainPreferences",
      "description": "Private per-user Trendz domain-following preferences strictly scoped to the authenticated owner for both reads and writes."
    },
    "/likes/{likeId}": {
      "schema": "Like",
      "description": "User upvotes and likes across posts, polls, and trends (deterministic IDs prevent duplicate upvotes)."
    },
    "/comments/{commentId}": {
      "schema": "Comment",
      "description": "User discussions and insights across posts and trends."
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "User-submitted content reports for moderator review."
    },
    "/trendSources/{sourceId}": {
      "schema": "TrendSource",
      "description": "Admin/moderator-only Trendz discovery source registry."
    },
    "/trendIngestionRuns/{runId}": {
      "schema": "TrendIngestionRun",
      "description": "Admin/moderator-only Trendz ingestion run logs and metrics."
    },
    "/trendIngestionItems/{itemId}": {
      "schema": "TrendIngestionItem",
