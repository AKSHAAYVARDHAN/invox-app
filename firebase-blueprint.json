      "schema": "TeamMember",
      "description": "Members belonging to a project team."
    },
    "/teams/{teamId}/messages/{messageId}": {
      "schema": "TeamMessage",
      "description": "Group chat messages sent within a team."
    },
    "/teams/{teamId}/joinRequests/{requestId}": {
      "schema": "TeamJoinRequest",
      "description": "Membership requests submitted by users for approval-required teams."
    },
    "/teamInvitations/{token}": {
      "schema": "TeamInvitation",
      "description": "Secure invitation tokens for joining project teams."
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notification documents."
    },
    "/bookmarks/{bookmarkId}": {
      "schema": "Bookmark",
      "description": "User bookmarked projects and posts collection."
    },
    "/follows/{followId}": {
      "schema": "Follow",
      "description": "User follow relationships."
    },
    "/communityMemberships/{membershipId}": {
      "schema": "CommunityMembership",
      "description": "User community memberships tracking joined technical communities."
    },
    "/communities/{communityId}": {
      "schema": "Community",
      "description": "Technical and domain communities with Collective Identity documents."
    },
    "/communities/{communityId}/healthSnapshots/{snapshotId}": {
      "schema": "CommunityHealthSnapshot",
      "description": "Private anonymized Community Health aggregate snapshots accessible exclusively to community owners and authorized administrators."
    },
    "/hubConversations/{conversationId}": {
      "schema": "HubConversation",
      "description": "Hub conversation channels with connection-restricted Comrades and membership-based Crew groups."
